<%@ page pageEncoding="UTF-8" %>
<%-- Cabecera común. Cada página define antes "titulo" y "seccion" (catalogo, favoritos, compras, admin). --%>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty titulo ? 'Concesionario' : titulo}"/> · Car4U</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@100..125,500..800&family=Instrument+Sans:wght@400..700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="<c:url value='/css/app.css'/>">
</head>
<body>
<%@ include file="/WEB-INF/jsp/comun/iconos.jspf" %>

<header class="cabecera">
    <div class="contenedor cabecera-fila">
        <a class="logo" href="<c:url value='/catalogo'/>">CAR<span>4</span>U</a>

        <ul class="menu">
            <li><a class="${seccion == 'catalogo' ? 'activo' : ''}" href="<c:url value='/catalogo'/>">Catálogo</a></li>
            <sec:authorize access="hasRole('CLIENTE')">
                <li><a class="${seccion == 'favoritos' ? 'activo' : ''}" href="<c:url value='/favoritos'/>">Favoritos</a></li>
                <li><a class="${seccion == 'compras' ? 'activo' : ''}" href="<c:url value='/mis-compras'/>">Mis compras</a></li>
            </sec:authorize>
            <sec:authorize access="hasRole('ADMIN')">
                <li><a class="${seccion == 'admin' ? 'activo' : ''}" href="<c:url value='/admin/coches'/>">Gestión de stock</a></li>
            </sec:authorize>
        </ul>

        <div class="cabecera-acciones">
            <sec:authorize access="isAnonymous()">
                <a class="boton boton-fantasma boton-sm" href="<c:url value='/login'/>">Iniciar sesión</a>
                <a class="boton boton-tinta boton-sm" href="<c:url value='/registro'/>">Crear cuenta</a>
            </sec:authorize>
            <sec:authorize access="isAuthenticated()">
                <sec:authentication property="principal.nombre" var="nombreUsuario"/>
                <div class="dropdown">
                    <button class="usuario-boton" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="avatar"><c:out value="${fn:toUpperCase(fn:substring(nombreUsuario, 0, 1))}"/></span>
                        <span class="usuario-nombre"><c:out value="${nombreUsuario}"/></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="d-md-none"><a class="dropdown-item" href="<c:url value='/catalogo'/>"><svg class="ico"><use href="#i-coche"/></svg>Catálogo</a></li>
                        <sec:authorize access="hasRole('CLIENTE')">
                            <li><a class="dropdown-item" href="<c:url value='/favoritos'/>"><svg class="ico"><use href="#i-corazon"/></svg>Favoritos</a></li>
                            <li><a class="dropdown-item" href="<c:url value='/mis-compras'/>"><svg class="ico"><use href="#i-bolsa"/></svg>Mis compras</a></li>
                        </sec:authorize>
                        <sec:authorize access="hasRole('ADMIN')">
                            <li><a class="dropdown-item" href="<c:url value='/admin/coches'/>"><svg class="ico"><use href="#i-lista"/></svg>Gestión de stock</a></li>
                        </sec:authorize>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form action="<c:url value='/logout'/>" method="post" class="m-0">
                                <input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
                                <button type="submit" class="dropdown-item"><svg class="ico"><use href="#i-salir"/></svg>Cerrar sesión</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </sec:authorize>
        </div>
    </div>
</header>

<main>
    <%-- Mensajes de las Actions (addActionMessage / addActionError), también tras una redirección.
         Con JSTL y no con tags de Struts: esta cabecera también la usan páginas que no pasan por
         Struts (p. ej. el 403 que sirve Spring Security), y ahí ${actionMessages} simplemente está vacío. --%>
    <c:if test="${not empty actionMessages or not empty actionErrors}">
        <div class="contenedor avisos">
            <c:forEach var="mensaje" items="${actionMessages}">
                <div class="aviso" role="status">
                    <svg class="ico"><use href="#i-check"/></svg>
                    <span><c:out value="${mensaje}"/></span>
                    <button type="button" class="cerrar" onclick="this.parentElement.remove()" aria-label="Cerrar"><svg class="ico ico-sm"><use href="#i-cruz"/></svg></button>
                </div>
            </c:forEach>
            <c:forEach var="error" items="${actionErrors}">
                <div class="aviso aviso-error" role="alert">
                    <svg class="ico"><use href="#i-alerta"/></svg>
                    <span><c:out value="${error}"/></span>
                </div>
            </c:forEach>
        </div>
    </c:if>
