<?xml version="1.0" encoding="UTF-8"?>
<!-- NetBeans: "Run" y "Debug" arrancan la aplicación con el Tomcat embebido de Spring Boot
     (en vez de intentar desplegar el WAR en un servidor registrado en el IDE). -->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>war</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
</actions>
